{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "node --watch-path=server --watch-path=src --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:browser": "node tools/playtest.mjs --headless --suite=prodguard,viewports",
    "check:deploy": "node scripts/verify-deploy.ts",
    "check:coop": "node tools/coop-live-check.mjs",
    "check:log": "node tools/coop-log-check.mjs",
    "check:xss": "node tools/coop-xss-check.mjs",
    "check:wipe": "node tools/coop-wipe-check.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "playtest": "node tools/playtest.mjs",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.ts"
  },
  "dependencies": {
    "kaplay": "^3001.0.19",
    "marked": "^18.0.14",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
